NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose defaults)
DATABASE_URL="postgresql://eventful:eventful@localhost:5432/eventful"

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate strong random secrets for production
JWT_ACCESS_SECRET=change-me-access-secret-must-be-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-must-be-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# QR signing — HMAC secret, keep it secret
QR_SIGNING_SECRET=change-me-qr-signing-secret-must-be-32-chars

# Tranzak — get keys from https://developer.tranzak.me
TRANZAK_APP_ID=your_app_id
TRANZAK_APP_KEY=SAND_your_app_key
TRANZAK_ENV=sandbox

# Email — Brevo transactional (https://app.brevo.com → API Keys)
BREVO_API_KEY=xkeysib-xxxx
BREVO_SENDER_EMAIL=noreply@eventful.app
BREVO_SENDER_NAME=Eventful

# SMS — Africa's Talking (optional, add in Phase 1 after email is proven)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox

# Public base URL (used in share links, email links)
APP_BASE_URL=http://localhost:3000
